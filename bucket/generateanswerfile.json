{
    "version": "2.3",
    "description": "CLI tool to generate answer files (unattend.xml/autounattend.xml) for unattended Windows installation",
    "homepage": "https://github.com/SvenGroot/GenerateAnswerFile",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "bin": [ [ "GenerateAnswerFile-2.3.0-x64.exe", "GenerateAnswerFile" ] ],
            "url": "https://github.com/SvenGroot/GenerateAnswerFile/releases/download/v2.3/GenerateAnswerFile-2.3.0-x64.exe",
            "hash": "65bc4e12ee1079ebd5c64271d67922cdb9bed43c749918c523d9babe7ef6bfbc"
        },
        "arm64": {
            "bin": [ [ "GenerateAnswerFile-2.3.0-arm64.exe", "GenerateAnswerFile" ] ],
            "url": "https://github.com/SvenGroot/GenerateAnswerFile/releases/download/v2.3/GenerateAnswerFile-2.3.0-arm64.exe",
            "hash": "71122a112c197730f99c04b535182d3ca9f7186aacf9ff75caa03c910dde90e2"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/SvenGroot/GenerateAnswerFile/refs/heads/main/LICENSE.txt -UseBasicParsing"
        ]
    },
    "checkver": {
        "github": "https://github.com/SvenGroot/GenerateAnswerFile"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "bin": [ [ "GenerateAnswerFile-2.3.0-x64.exe", "GenerateAnswerFile" ] ],
                "url": "https://github.com/SvenGroot/GenerateAnswerFile/releases/download/v$version/GenerateAnswerFile-$version.0-x64.exe"
            },
            "arm64": {
                "bin": [ [ "GenerateAnswerFile-2.3.0-arm64.exe", "GenerateAnswerFile" ] ],
                "url": "https://github.com/SvenGroot/GenerateAnswerFile/releases/download/v$version/GenerateAnswerFile-$version.0-arm64.exe"
            }
        }
    }
}
