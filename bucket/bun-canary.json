{
    "version": "1.4.4-canary.1+963452075",
    "description": "Incredibly fast JavaScript runtime, bundler, transpiler and package manager - all in one.",
    "homepage": "https://bun.sh/",
    "license": "MIT",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-x64.zip",
                "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-x64-baseline.zip"
            ],
            "hash": [
                "f5bc840279f30a263bc41cc0400c6288088911a150d3a9e1cc74e899af98a4b2",
                "bd4144830c176e57e46ddb91564ba18bb1fbf63f63669af5d5ad406c0de3eb6c"
            ]
        },
        "arm64": {
            "url": "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-aarch64.zip",
            "hash": "649c0c65ad07a7c238b95d952507147d0a816d45af120e489b28037efcbfb5d1"
        }
    },
    "pre_install": [
        "# Extract the appropriate binary based on architecture and CPU features",
        "if ($architecture -eq 'arm64') {",
        "    $target = 'bun-windows-aarch64'",
        "}",
        "else {",
        "    $avx2 = Start-Job {",
        "        Add-Type Kernel32 '[DllImport(\"kernel32.dll\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);' -NS Win32",
        "        return [Win32.Kernel32]::IsProcessorFeaturePresent(40)",
        "    } | Receive-Job -Wait -AutoRemoveJob",
        "    $target = 'bun-windows-x64'",
        "    if (-not $avx2) {",
        "        $target += '-baseline'",
        "    }",
        "}",
        "Move-Item -PSPath $dir\\$target\\bun.exe $dir\\bun.exe",
        "Get-ChildItem -PSPath $dir -Filter bun-windows-* | Remove-Item -Recurse"
    ],
    "bin": [
        "bun.exe",
        [
            "bun.exe",
            "bunx",
            "x"
        ]
    ],
    "checkver": {
        "script": [
            "$dl_url = 'https://github.com/oven-sh/bun/releases/download/canary/bun-windows-x64.zip'",
            "$dl_path = cache_path 'bun-canary' 'unknown' $dl_url",
            "$dl_dir = [IO.Path]::GetDirectoryName($dl_path)",
            "Invoke-WebRequest -OutFile $dl_path $dl_url",
            "[void](Expand-Archive -LiteralPath $dl_path -DestinationPath $dl_dir)",
            "$ver = & \"$dl_dir\\bun-windows-x64\\bun.exe\" --revision",
            "Remove-Item -PSPath $dl_path, $dl_dir\\bun-windows-x64 -Recurse -Force",
            "return $ver"
        ],
        "regex": "(?<version>\\S+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-x64.zip",
                    "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-x64-baseline.zip"
                ]
            },
            "arm64": {
                "url": "https://github.com/oven-sh/bun/releases/download/canary/bun-windows-aarch64.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/oven-sh/bun/releases/tags/canary",
            "jsonpath": "$..assets[?(@.name == '$basename')].digest"
        }
    }
}
