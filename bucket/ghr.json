{
    "version": "0.9.0",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.9.0-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.9.0/ghr-0.9.0-windows-x64.zip",
            "hash": "560a6fbcc7d4d95b9e4b1d1c1e282d293939d6a6fa558249cba8e513c0057a8a"
        },
        "arm64": {
            "extract_dir": "ghr-0.9.0-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.9.0/ghr-0.9.0-windows-arm64.zip",
            "hash": "a1a2b15049e2eca732dedaf127725659401747a6074f016cb10bf7756b5ab2e5"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
