{
    "version": "0.9.1",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.9.1-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.9.1/ghr-0.9.1-windows-x64.zip",
            "hash": "58bc3cbeccb012b078a896580bf3acc207b5f34038320e280de38ec88e28bbbe"
        },
        "arm64": {
            "extract_dir": "ghr-0.9.1-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.9.1/ghr-0.9.1-windows-arm64.zip",
            "hash": "cc3920274adf337a3434a1568bd9b14699bb8d5cae2628654070de2bfb0a5d8d"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
