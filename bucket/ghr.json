{
    "version": "0.10.5",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.10.5-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.5/ghr-0.10.5-windows-x64.zip",
            "hash": "66592ff2fa942e990bef991224848d8f087dcba506856b720c46eb11d3b069ca"
        },
        "arm64": {
            "extract_dir": "ghr-0.10.5-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.5/ghr-0.10.5-windows-arm64.zip",
            "hash": "0915211d2568fc6270517ea0933094597b528857102e47bbdd953035f7f18ba0"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
