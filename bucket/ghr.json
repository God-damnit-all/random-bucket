{
    "version": "0.10.0",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.10.0-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.0/ghr-0.10.0-windows-x64.zip",
            "hash": "8e698abd0c166afbf05f27558345f01832db39d2b6dcd82b70f62c20fb6da4e8"
        },
        "arm64": {
            "extract_dir": "ghr-0.10.0-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.0/ghr-0.10.0-windows-arm64.zip",
            "hash": "dc5a10ab52d577930fc2dcc6011655e72721996d63dc00cfb2bb89d6a17b6a3b"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
