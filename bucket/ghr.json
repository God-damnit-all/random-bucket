{
    "version": "0.10.4",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.10.4-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.4/ghr-0.10.4-windows-x64.zip",
            "hash": "ac5bb36f153ade0f311f1916eb616f1d3d50dbe4567ab64a420f08f562d67008"
        },
        "arm64": {
            "extract_dir": "ghr-0.10.4-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.4/ghr-0.10.4-windows-arm64.zip",
            "hash": "3466a94cacb5c6c720f2f1844a2ac344e6f4104636ba39f81873cec00831f413"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
