{
    "version": "0.10.2",
    "description": "A toolkit for GitHub releases",
    "homepage": "https://github.com/cataggar/ghr",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "ghr-0.10.2-windows-x64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.2/ghr-0.10.2-windows-x64.zip",
            "hash": "c72571c5f91892f15361890014af462831e677c39c971ad5c3b4e368fa8d13c6"
        },
        "arm64": {
            "extract_dir": "ghr-0.10.2-windows-arm64",
            "url": "https://github.com/cataggar/ghr/releases/download/v0.10.2/ghr-0.10.2-windows-arm64.zip",
            "hash": "246f0defa717c595b1ec07396009d23c6809e1c76fc92dfb0555a91bb0657a1f"
        }
    },
    "bin": "ghr.exe",
    "installer": {
        "script": [
            "Move-Item -PSPath $dir/bin/ghr.exe -Destination $dir",
            "Remove-Item -PSPath $dir/bin"
        ]
    },
    "checkver": {
        "github": "https://github.com/cataggar/ghr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "extract_dir": "ghr-$version-windows-x64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-x64.zip"
            },
            "arm64": {
                "extract_dir": "ghr-$version-windows-arm64",
                "url": "https://github.com/cataggar/ghr/releases/download/v$version/ghr-$version-windows-arm64.zip"
            }
        }
    }
}
