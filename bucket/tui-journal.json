{
    "version": "0.18.0",
    "description": "Write and manage your journal/notes from within the comfort of your terminal",
    "homepage": "https://github.com/AmmarAbouZor/tui-journal",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AmmarAbouZor/tui-journal/releases/download/v0.18.0/tjournal-win.zip",
            "hash": "d54f332b9609bf30699d160f22891952b1bb1cf67a6b96c1276f3da41957dd5a"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "if (Test-Path -PSPath $dir/LICENSE) { return }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/AmmarAbouZor/tui-journal/refs/heads/main/LICENSE -UseBasicParsing"
        ]
    },
    "bin": [
        "tjournal.exe",
        [
            "tjournal.exe",
            "tui-journal"
        ]
    ],
    "checkver": {
        "github": "https://github.com/AmmarAbouZor/tui-journal"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AmmarAbouZor/tui-journal/releases/download/v$version/tjournal-win.zip"
            }
        }
    }
}
