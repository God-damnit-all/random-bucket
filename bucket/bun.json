{
    "version": "1.4.2",
    "description": "Incredibly fast JavaScript runtime, bundler, transpiler and package manager - all in one.",
    "homepage": "https://bun.sh/",
    "license": "MIT",
    "notes": "For the last release built on the original Zig codebase, use `versions/bun1.3`.",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-windows-x64.zip",
                "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-windows-x64-baseline.zip"
            ],
            "hash": [
                "ce4c17497b2f29712a99d3d53f028de28cd42e3bacb8589599e7f000e49b6405",
                "78c221c2376f79731ccf4e4af0b3bb46d81fefa3296c5abee09ad8a1b21e68c6"
            ]
        },
        "arm64": {
            "url": "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-windows-aarch64.zip",
            "hash": "a7a16b876a305fd1029c66dbd27007b4f6112ae896532f675878731a21e50cfd"
        }
    },
    "pre_install": [
        "# Extract the appropriate binary based on architecture and CPU features",
        "if ($architecture -eq 'arm64') {",
        "    $target = 'bun-windows-aarch64'",
        "}",
        "else {",
        "    $avx2 = Start-Job {",
        "        Add-Type Kernel32 '[DllImport(\"kernel32.dll\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);' -NS Win32",
        "        return [Win32.Kernel32]::IsProcessorFeaturePresent(40)",
        "    } | Receive-Job -Wait -AutoRemoveJob",
        "    $target = 'bun-windows-x64'",
        "    if (-not $avx2) {",
        "        $target += '-baseline'",
        "    }",
        "}",
        "Move-Item -PSPath $dir\\$target\\bun.exe $dir\\bun.exe",
        "Get-ChildItem -PSPath $dir -Filter bun-windows-* | Remove-Item -Recurse"
    ],
    "bin": [
        "bun.exe",
        [
            "bun.exe",
            "bunx",
            "x"
        ]
    ],
    "checkver": {
        "github": "https://github.com/oven-sh/bun",
        "regex": "bun-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/oven-sh/bun/releases/download/bun-v$version/bun-windows-x64.zip",
                    "https://github.com/oven-sh/bun/releases/download/bun-v$version/bun-windows-x64-baseline.zip"
                ]
            },
            "arm64": {
                "url": "https://github.com/oven-sh/bun/releases/download/bun-v$version/bun-windows-aarch64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHASUMS256.txt"
        }
    }
}
