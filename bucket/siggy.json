{
    "version": "1.15.0",
    "description": "TUI Signal messenger client with an IRC aesthetic and Vim-like keybindings",
    "homepage": "https://github.com/johnsideserf/siggy",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/johnsideserf/siggy/releases/download/v1.15.0/siggy-v1.15.0-x86_64-pc-windows-msvc.zip",
            "hash": "16b15e2b92049a30f27dc9d151e7a91477100be877b74998feafce2949821ad5"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "if (Test-Path -PSPath $dir/LICENSE) { return }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/johnsideserf/siggy/refs/heads/master/LICENSE -UseBasicParsing"
        ]
    },
    "bin": "siggy.exe",
    "checkver": {
        "github": "https://github.com/johnsideserf/siggy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/johnsideserf/siggy/releases/download/v$version/siggy-v$version-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
