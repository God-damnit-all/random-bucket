        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "if (Test-Path -PSPath $dir/LICENSE) { return }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/tikrack/peek/refs/heads/main/LICENSE -UseBasicParsing"
        ]
    },
    "bin": "peek.exe",
    "checkver": {
        "github": "https://github.com/tikrack/peek"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tikrack/peek/releases/download/v$version/peek.exe"
            }
        }
    }
}
