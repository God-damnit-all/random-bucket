{
    "version": "2022.12.11",
    "description": "CLI Ebook (epub2, epub3, fb2, mobi) Reader",
    "homepage": "https://github.com/wustho/epy",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/wustho/epy/releases/download/v2022.12.11/epy-win.exe",
            "hash": "7ce5a1540f52e83005ff390348305b2c9b8ed4efefe0e4f2cbdbeac32e41314c"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "if (Test-Path -PSPath $dir/LICENSE) { return }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/wustho/epy/refs/heads/master/LICENSE -UseBasicParsing"
        ]
    },
    "bin": [ [ "epy-win.exe", "epy" ] ],
    "checkver": {
        "github": "https://github.com/wustho/epy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/wustho/epy/releases/download/v$version/epy-win.exe"
            }
        }
    }
}
