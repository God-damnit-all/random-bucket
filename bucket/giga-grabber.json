{
    "version": "1.3.6",
    "description": "A fast and stable MEGA downloader with both a GUI and CLI functionality",
    "homepage": "https://github.com/chanderlud/giga-grabber",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chanderlud/giga-grabber/releases/download/v1.3.6/giga-grabber-1.3.6-windows-standalone-x86_64.exe#/giga-grabber.exe",
            "hash": "52b2f0cc911fc6e26b6ff54898887524c7809461697c384000ebdbd0351f3593"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "[void](New-Item $persist_dir -Type D -Force)",
            "[void](New-Item $persist_dir/config.json -ea 0 | Set-Content '{\"theme\":\"Vanilla\",\"check_for_updates\":false,\"persist_download_sessions\":false,\"show_progress_bars\":true,\"show_download_sizes\":true,\"max_workers\":10,\"concurrency_budget\":10,\"max_retries\":3,\"timeout\":{\"secs\":20,\"nanos\":0},\"max_retry_delay\":{\"secs\":30,\"nanos\":0},\"min_retry_delay\":{\"secs\":10,\"nanos\":0},\"proxy_mode\":\"None\",\"proxies\":[]}')",
            "[void](New-Item $persist_dir/giga-grabber.log -ea 0)",
            "Set-Content -PSPath $dir/giga-grabber.cmd '@\"%~dp0giga-grabber.exe\" %*'",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/chanderlud/giga-grabber/refs/heads/main/LICENSE -UseBasicParsing"
        ]
    },
    "bin": [
        [
            "giga-grabber.cmd",
            "giga-grabber"
        ]
    ],
    "shortcuts": [
        [
            "giga-grabber.exe",
            "Giga Grabber"
        ]
    ],
    "persist": [
        "config.json",
        "giga-grabber.log"
    ],
    "checkver": {
        "github": "https://github.com/chanderlud/giga-grabber"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chanderlud/giga-grabber/releases/download/v$version/giga-grabber-$version-windows-standalone-x86_64.exe#/giga-grabber.exe"
            }
        }
    }
}
