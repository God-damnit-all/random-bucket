{
    "version": "2.5.9",
    "description": "A keyboard-driven Git TUI that displays repositories, worktrees, stashes, and branches",
    "homepage": "https://github.com/tareqmy/gitwig",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/tareqmy/gitwig/releases/download/v2.5.9/gitwig-v2.5.9-x86_64-pc-windows-msvc.zip",
            "hash": "81bbaf2d77954121d6a7c518c3eee66718059c2d9645856610989e3381c96dc5"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "if (Test-Path -PSPath $dir/LICENSE) { return }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE https://raw.githubusercontent.com/TheYahya/enola/refs/heads/main/LICENSE -UseBasicParsing"
        ]
    },
    "bin": "gitwig.exe",
    "checkver": {
        "github": "https://github.com/tareqmy/gitwig"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tareqmy/gitwig/releases/download/v$version/gitwig-v$version-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
