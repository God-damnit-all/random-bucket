    "version": "2.9.2",
    "description": "Coherent PDF Command Line Tools is a powerful cross-platform utility used to modify, merge, split, encrypt, and manipulate PDFs without quality loss",
    "homepage": "https://github.com/coherentgraphics/cpdf-binaries",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://codeload.github.com/coherentgraphics/cpdf-binaries/zip/refs/heads/master#/2.9.2.zip",
            "hash": "1812baed7c602d4f5489cee7e919ef78e23981379b47fa1ee3bf7c876f4b1219"
        },
        "32bit": {
            "url": "https://codeload.github.com/coherentgraphics/cpdf-binaries/zip/refs/heads/master#/2.9.2.zip",
            "hash": "1812baed7c602d4f5489cee7e919ef78e23981379b47fa1ee3bf7c876f4b1219"
        }
    },
    "extract_dir": "cpdf-binaries-master",
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "trap { throw $_ }",
            "Move-Item -PSPath $dir/Windows-$architecture/cpdf.exe $dir/cpdf.exe",
            "(Get-ChildItem -PSPath $dir -ad).ForEach{ if( $_.Parent.Name -ne $version ){ throw } $_.Delete($true) }"
        ]
    },
    "bin": "cpdf.exe",
    "checkver": {
        "url": "https://api.github.com/repos/coherentgraphics/cpdf-binaries/tags",
        "regex": "^.+?v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://codeload.github.com/coherentgraphics/cpdf-binaries/zip/refs/heads/master#/$version.zip"
            },
            "32bit": {
                "url": "https://codeload.github.com/coherentgraphics/cpdf-binaries/zip/refs/heads/master#/$version.zip"
            }
        }
    }
}
