{
    "version": "0.9.3",
    "description": "Cargo plugin to generate list of all licenses for a crate",
    "homepage": "https://github.com/EmbarkStudios/cargo-about",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "cargo-about-0.9.3-x86_64-pc-windows-msvc",
            "url": "https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.3/cargo-about-0.9.3-x86_64-pc-windows-msvc.tar.gz",
            "hash": "9e2942533ef1c592c4a70bdb384cae1550a3f5fc9ae40379b6662e3d2f16fe02"
        }
    },
    "bin": "cargo-about.exe",
