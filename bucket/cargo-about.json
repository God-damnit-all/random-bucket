{
    "version": "0.9.2",
    "description": "Cargo plugin to generate list of all licenses for a crate",
    "homepage": "https://github.com/EmbarkStudios/cargo-about",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "extract_dir": "cargo-about-0.9.2-x86_64-pc-windows-msvc",
            "url": "https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.2/cargo-about-0.9.2-x86_64-pc-windows-msvc.tar.gz",
            "hash": "1c03e5890238562497c2d89a3b75b02560af349c1fc3e713d3284f532a5cd748"
        }
    },
    "bin": "cargo-about.exe",
