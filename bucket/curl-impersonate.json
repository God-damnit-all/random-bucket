{
    "version": "2.2.2",
    "description": "A 'curl' fork that can impersonate the 4 major browsers (Chrome/Edge/Safari/Firefox), performing TLS & HTTP handshakes identical to theirs",
    "homepage": "https://github.com/lexiforest/curl-impersonate",
    "license": "MIT,curl",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v2.2.2/curl-impersonate-v2.2.2.x86_64-win32.tar.gz",
            "hash": "79afdde4375570760fbf7c25c3686b2ab79bfadb7be1a6658369b0cb57ab5c45"
        },
        "32bit": {
            "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v2.2.2/curl-impersonate-v2.2.2.i686-win32.tar.gz",
            "hash": "304135a4151061694c7c20190ff8ff9dd262181b5475836cabe16321baa200c4"
        },
        "arm64": {
            "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v2.2.2/curl-impersonate-v2.2.2.arm64-win32.tar.gz",
            "hash": "eed8945a026e9d1bbce1b532d532926292bf7e7b93a589cf6bd7f9a55708d56c"
        }
    },
    "bin": "curl-impersonate.exe",
    "post_install": [
        "Write-Host $null",
        "Get-ChildItem -PSPath $dir -Filter *.bat | &{process{",
        "    Write-Host \"Creating shim for '$($_.BaseName)'\"",
        "    shim \"$dir\\$($_.Name)\" $global $_.BaseName",
        "}}"
    ],
    "pre_uninstall": [
        "Write-Host $null",
        "Get-ChildItem -PSPath $dir -Filter *.bat | &{process{",
        "    rm_shim $_.BaseName (shimdir $global)",
        "}}"
    ],
    "checkver": {
        "github": "https://github.com/lexiforest/curl-impersonate"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v$version/curl-impersonate-v$version.x86_64-win32.tar.gz"
            },
            "32bit": {
                "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v$version/curl-impersonate-v$version.i686-win32.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/lexiforest/curl-impersonate/releases/download/v$version/curl-impersonate-v$version.arm64-win32.tar.gz"
            }
        }
    }
}
