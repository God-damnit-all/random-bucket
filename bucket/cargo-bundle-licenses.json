{
    "version": "5.0.0",
    "description": "Generate a THIRDPARTY file containing all licenses in a cargo project",
    "homepage": "https://github.com/sstadick/cargo-bundle-licenses",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sstadick/cargo-bundle-licenses/releases/download/v5.0.0/cargo-bundle-licenses-windows-amd64#/cargo-bundle-licenses.exe",
            "hash": "b422048f8c233d529f82fcc80cc48e75d1a3936010104fb079fbe747e4db48d0"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference, $ProgressPreference = 'Stop', 'SilentlyContinue'",
            "trap { throw $_ }",
            "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072",
            "Invoke-WebRequest -OutFile $dir/LICENSE-APACHE https://raw.githubusercontent.com/sstadick/cargo-bundle-licenses/refs/heads/main/LICENSE-APACHE -UseBasicParsing",
            "Invoke-WebRequest -OutFile $dir/LICENSE-MIT https://raw.githubusercontent.com/sstadick/cargo-bundle-licenses/refs/heads/main/LICENSE-MIT -UseBasicParsing"
        ]
    },
    "bin": "cargo-bundle-licenses.exe",
    "checkver": {
        "github": "https://github.com/sstadick/cargo-bundle-licenses"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sstadick/cargo-bundle-licenses/releases/download/v$version/cargo-bundle-licenses-windows-amd64#/cargo-bundle-licenses.exe"
            }
        }
    }
}
