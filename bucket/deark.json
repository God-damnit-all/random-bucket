{
    "version": "1.7.3",
    "description": "A utility for file format and metadata analysis, data extraction, decompression, and image format decoding",
    "homepage": "https://entropymine.com/deark",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://entropymine.com/deark/releases/deark-1.7.3.tar.gz",
            "hash": "84f9e0134830389e4ab12c89dc09cf42a3f885ec551254e9fdc22952858add11"
        }
    },
    "extract_dir": "deark-1.7.3",
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "trap { throw $_ }",
            "(Get-ChildItem -PSPath $dir -af).Where{ $_.Name -notmatch 'COPYING|\\.md$' } | &{process{",
            "  if( $_.Directory.Name -ne $version ){ throw } else { $_.Delete() }",
            "}}",
            "Move-Item -PSPath $dir/x64/deark.exe $dir/deark.exe",
            "Get-ChildItem -PSPath $dir -ad | &{process{",
            "  if( $_.Parent.Name -ne $version ){ throw } else { $_.Delete($true) }",
            "}}"
        ]
    },
    "bin": "deark.exe",
    "checkver": {
        "url": "https://entropymine.com/deark",
        "regex": "deark-([\\d.]+)\\.tar\\.gz"
    },
    "autoupdate": {
        "extract_dir": "deark-$version",
        "architecture": {
            "64bit": {
                "url": "https://entropymine.com/deark/releases/deark-$version.tar.gz"
            }
        }
    }
}
